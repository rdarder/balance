<mujoco>
    <asset>
        <texture name="tex-checker" type="2d" builtin="checker" rgb1=".7 .7 .7" rgb2=".8 .8 .8" width="100"
                 height="100"/>
        <material name="color-dark" rgba="0.23 0.12 0.17 .5"/>
        <material name="color-red" rgba="0.86 0.09 0.18 .5"/>
        <material name="color-vanilla" rgba="0.86 0.87 0.67 .5"/>
        <material name="color-gray" rgba="0.37 0.46 0.56 .5"/>
        <material name="color-blue" rgba="0.22 0.22 0.38 .5"/>
        <material name="mat-plane" texture="tex-checker" texrepeat="10 10" texuniform="true"/>
    </asset>

    <worldbody>
        <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
        <geom type="plane" size="1 1 0.1" material="mat-plane"/>
        <body name="chassis" pos="0 0 1">
            <joint type="free"/>
            <geom type="box" size=".04 .011 .045" material="color-vanilla" mass="0.027"/>
            <body name="left-wheel" pos="-0.048 0.002 -0.025">
                <joint name="left-wheel-joint" type="hinge" axis="1 0 0" damping="0.01"/>
                <geom type="cylinder" size="0.0265 0.006" material="color-blue" mass="0.16" euler="0 90 0"/>
            </body>
            <body name="right-wheel" pos="0.048 0.002 -0.025">
                <joint name="right-wheel-joint" type="hinge" axis="1 0 0" damping="0.01"/>
                <geom type="cylinder" size="0.0265 0.006" material="color-blue" mass="0.16" euler="0 90 0"/>
            </body>
            <body name="battery" pos="0 0 -0.032">
                <geom type="cylinder" size="0.009 0.0325" material="color-dark" mass="0.047" euler="0 90 0"/>
            </body>
            <body name="left-motor-body" pos="-0.028 0.001 -0.005">
                <geom type="box" size="0.0125 0.0075 0.010" material="color-red" mass="0.017"/>
            </body>
            <body name="right-motor-body" pos="0.028 0.001 -0.005">
                <geom type="box" size="0.0125 0.0075 0.010" material="color-red" mass="0.017"/>
            </body>
            <site name="imu" pos="0 0 0.035" size="0.001" rgba="1 0 0 0.5"/>
        </body>
    </worldbody>
    <sensor>
        <accelerometer name="imu_accel" site="imu"/>
        <gyro name="imu_gyro" site="imu"/>
    </sensor>
    <actuator>
        <!-- Motor actuators-->
        <!--Motor torque = 20g/cm = 0.00196NM. gear ratio = 39/8 = 4.875. Setting the gear as torque*ratio so the
        control range maps to 1 = full torque. Mujoco is not intuitive in how ctrllimited and forcerange are applied.
        -->
        <motor name="left-motor" joint="left-wheel-joint" gear="0.0096" ctrllimited="true" ctrlrange="-1.0 1.0"/>
        <motor name="right-motor" joint="right-wheel-joint" gear="0.0096" ctrllimited="true" ctrlrange="-1.0 1.0"
        />
    </actuator>
</mujoco>